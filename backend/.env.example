# ============================================
# ResQ-AI Backend Environment Configuration
# ============================================

# LLM API Configuration (Gemini / Groq / OpenAI)
# In DEMO MODE, system falls back to deterministic simulated incident parsing
LLM_API_KEY=your_llm_api_key_here
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
DEMO_MODE=true

# Database Configuration (PostgreSQL Neon / Local / SQLite fallback)
DATABASE_URL=postgresql://neondb_owner:password@ep-muddy-fog-b5robq5v-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Application Runtime Settings
APP_ENV=development
APP_DEBUG=true
HOST=0.0.0.0
PORT=8000
AUTO_SEED_ON_STARTUP=true

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
