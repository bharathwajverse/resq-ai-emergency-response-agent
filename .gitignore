*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt
.Python
develop-eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.manifest
*.spec

# ----- Virtual Environments -----
.venv/
venv/
ENV/
env/
.env
.env.local
.env.production
.env.staging

# ----- Node / Frontend -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js
frontend/dist/
frontend/build/
.eslintcache

# ----- IDE / Editor -----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ----- OS Files -----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----- Testing -----
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# ----- Database -----
*.db
*.sqlite
*.sqlite3

# ----- Secrets / Keys -----
*.pem
*.key
secrets.yaml
secrets.json

# ----- Logs -----
*.log
logs/

# ----- Teamwork Agent Internal Files -----
.agents/

# ----- Misc -----
*.bak
*.tmp
*.temp
